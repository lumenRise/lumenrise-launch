NODE_ENV=development
LOG_LEVEL=info
DB_URI=mongodb://127.0.0.1:27017?replicaSet=rs0&directConnection=true
DB_NAME=lumenrise

STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
LAUNCH_TESTNET_FACTORY_CONTRACT_ID=C....
STELLAR_TESTNET_HOME_DOMAIN=testnet.lumenrise.app
STELLAR_TESTNET_TOML_DIRNAME=/var/www/lumenrise/
STELLAR_TESTNET_TOML_FILENAME=testnet_stellar.toml

STELLAR_PUBLIC_RPC_URL=
STELLAR_PUBLIC_HORIZON_URL=https://horizon.stellar.org
LAUNCH_PUBLIC_FACTORY_CONTRACT_ID=C....
STELLAR_PUBLIC_HOME_DOMAIN=lumenrise.app
STELLAR_PUBLIC_TOML_DIRNAME=/var/www/lumenrise/
STELLAR_PUBLIC_TOML_FILENAME=stellar.toml

LAUNCH_POLL_INTERVAL_MS=5000

RABBITMQ_URL=amqp://lumenrise:password@127.0.0.1:5672
RABBITMQ_USER=lumenrise
RABBITMQ_PASSWORD=password

