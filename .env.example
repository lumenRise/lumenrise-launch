# Allowed values: "development", "test", "production"
NODE_ENV=development

# Logging verbosity.
# Allowed values: "fatal", "error", "warn", "info", "debug", "trace", "silent"
LOG_LEVEL=info

# MongoDB connection string shared with the API.
DB_URI=mongodb://127.0.0.1:27017?replicaSet=rs0&directConnection=true

# MongoDB database name shared with the API.
DB_NAME=lumenrise

# Stellar network used by the launch factory.
# Allowed values: "testnet", "public"
STELLAR_AUTH_NETWORK=testnet

# Stellar RPC endpoint for read-only contract calls.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Funded Stellar account used as the source for simulations.
STELLAR_READ_ACCOUNT=GDAUDEZPAI4QV2.....................SQOYBNFZWPVYXBHQH

# Bonding-curve factory contract ID.
LAUNCH_FACTORY_CONTRACT_ID=CDDM43ZQB34YLYAPAN2EALMRNF32PUYUUOFILKWZJLXHKEQA6JEBN5PC

# Milliseconds between factory scans.
LAUNCH_POLL_INTERVAL_MS=5000
