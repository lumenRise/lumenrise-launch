{
  "name": "lumenrise-launch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --target=node24 --outdir=dist",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "env:sync": "envyra sync --config src/env.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.1.0",
    "envyra": "^0.1.6",
    "mongoose": "9.10.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
